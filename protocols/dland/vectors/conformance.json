{
  "spec": "Ð:LAND",
  "version": "2",
  "h3_library": "4.2.1",
  "constants": {
    "h3_anchor_res": 12,
    "h3_district_res": 7,
    "h3_region_res": 4,
    "window": 30,
    "reanchor_cooldown": 144,
    "max_payload": 16384,
    "max_depth": 32
