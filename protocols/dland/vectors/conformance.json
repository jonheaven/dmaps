      "description": "Valid pack with inline schema",
      "body": "{\"p\":\"Ð:LAND\",\"v\":\"1\",\"op\":\"pack\",\"name\":\"street-scene\",\"version\":\"1.0.0\",\"schema\":{\"type\":\"object\"}}",
      "expect": "pass"
    },
