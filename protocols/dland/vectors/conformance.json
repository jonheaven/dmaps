  "chain": [
    "T1 non-holder build (no title spend) → ignored",
    "T2 transfer then previous holder's pending build → never applies",
    "T3 same-block transfer before reveal: reveal must spend the post-transfer outpoint or it is invalid",
    "T4 holder-signed classic (unbound) build → ignored",
    "T5 replay of a spent title outpoint → invalid",
    "T6 A commits cell C at h=1; B copies and reveals at h=2; A reveals at h=3 → A wins",
    "T7 two anchors on one cell: lower priority key wins; once final, no displacement",
    "T8 reorg of the founding anchor block → founder and occupancy roll back",
    "re-anchor inside 144-block cooldown → invalid; previous cell unchanged",
    "anchor on a parcel with only an OG {n}.dogemap (no v1 claim) → invalid"
  ]
}
