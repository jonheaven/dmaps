      "description": "Lower commit key displaces a pending occupant",
      "existing": {
        "key": {
          "height": 10,
          "tx_index": 1,
          "vout": 0
        }
      },
      "incoming": {
        "key": {
          "height": 9,
          "tx_index": 5,
          "vout": 0
        }
      },
      "tip": 12,
      "can_take": true
    },
    {
      "id": "T7-final",
      "description": "Final occupant cannot be displaced",
      "existing": {
        "key": {
          "height": 10,
          "tx_index": 1,
          "vout": 0
        }
      },
      "incoming": {
        "key": {
          "height": 1,
          "tx_index": 0,
          "vout": 0
        }
      },
      "tip": 41,
      "can_take": false
    }
