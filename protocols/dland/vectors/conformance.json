  "authorize": [
    {
      "id": "T1-non-holder",
      "expect": "fail",
      "why": "no_title_spend",
      "description": "Stranger signs but does not spend the current title UTXO",
      "facts": {
        "committed": true,
        "spends_title_outpoint": false,
        "title_is_canonical": true,
        "body_title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaai0",
        "canonical_title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaai0",
        "stale_outpoint": false
      }
    },
    {
      "id": "T2-stale-holder",
      "expect": "fail",
      "why": "stale_outpoint",
      "description": "Previous holder after transfer: outpoint already moved",
      "facts": {
        "committed": true,
        "spends_title_outpoint": true,
        "title_is_canonical": true,
        "body_title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaai0",
        "canonical_title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaai0",
        "stale_outpoint": true
      }
    },
    {
      "id": "T4-unbound",
      "expect": "fail",
      "why": "unbound",
      "description": "Classic (unbound) reveal — body can be swapped",
      "facts": {
        "committed": false,
        "spends_title_outpoint": true,
        "title_is_canonical": true,
        "body_title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaai0",
        "canonical_title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaai0",
        "stale_outpoint": false
      }
    },
    {
      "id": "T5-title-mismatch",
      "expect": "fail",
      "why": "title_mismatch",
      "description": "Body names a different inscription than the spent title",
      "facts": {
        "committed": true,
        "spends_title_outpoint": true,
        "title_is_canonical": true,
        "body_title": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccci0",
        "canonical_title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaai0",
        "stale_outpoint": false
      }
    },
    {
      "id": "T-ok",
      "expect": "pass",
      "description": "Current holder spends the title in a committed reveal",
      "facts": {
        "committed": true,
        "spends_title_outpoint": true,
        "title_is_canonical": true,
        "body_title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaai0",
        "canonical_title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaai0",
        "stale_outpoint": false
      }
    }
  ],
  "cell": [
    {
      "id": "T6-frontrun",
      "description": "Earlier commit outranks a later reveal-copy",
      "existing": {
        "key": {
          "height": 10,
          "tx_index": 1,
          "vout": 0
        }
